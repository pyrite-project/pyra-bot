# Public HTTPS origin of this service. Loopback HTTP is allowed only for local checks.
PUBLIC_URL=https://pyra.example.com
PORT=3000

# GitHub App settings: App ID (numeric), downloaded private key, and Webhook secret.
# Store real secrets only in an ignored .env or a deployment secret store.
APP_ID=123456
PRIVATE_KEY_PATH=./data/github-app.pem
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# User authorization settings of the SAME GitHub App, not a second OAuth App.
# Callback URL must be PUBLIC_URL + /builder/oauth/callback.
GITHUB_CLIENT_ID=from-github-app-settings
GITHUB_CLIENT_SECRET=from-github-app-client-secrets

# Explicitly trusted target repositories and base branches; comma-separated.
# The workflow must exist on the actual PR base branch. No default-branch fallback.
GITHUB_REPOSITORIES=pyrite-project/pyrite-ide
BUILD_BASE_BRANCHES=main,develop

# Persistent SQLite and bounded staging space. Back up the complete data directory.
DATABASE_PATH=./data/pyra.sqlite
TEMP_DIRECTORY=./data/tmp

# Obtain endpoint, region and private bucket name from Backblaze Bucket settings.
# Example endpoint format: https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_BUCKET=your-private-preview-bucket
B2_PREFIX=pr-builds

# Create standard application keys restricted to this bucket and prefix.
# Upload: writeFiles. Read/sign/head: readFiles.
# Enumerate and permanently delete every exact-key version: listFiles + deleteFiles.
# Some SDK/account operations may additionally require listBuckets/listAllBucketNames.
# Never use a master key or place any of these keys in the IDE Actions secrets.
B2_UPLOAD_KEY_ID=from-backblaze-application-keys
B2_UPLOAD_KEY=secret-upload-application-key
B2_READ_KEY_ID=from-backblaze-application-keys
B2_READ_KEY=secret-read-application-key
B2_DELETE_KEY_ID=from-backblaze-application-keys
B2_DELETE_KEY=secret-delete-application-key

# Optional limits: bytes, concurrent matrix runs, per-repository UTC-day dispatches.
MAX_ARCHIVE_BYTES=2147483648
MAX_FILE_BYTES=1073741824
MAX_PARALLEL_BUILDS=2
DAILY_BUILD_LIMIT=50
REBUILD_COOLDOWN_SECONDS=600
# Bound uncertain dispatch recovery; timeout frees capacity without dispatching twice.
DISPATCH_RESOLUTION_TIMEOUT_SECONDS=900
TASK_POLL_SECONDS=5
